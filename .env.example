# ---- App ----
APP_NAME=AI Resume Platform
ENVIRONMENT=development
DEBUG=true
# Public URL that Telegram / Calendly webhooks are reachable at.
#  - Local dev: a tunnel (cloudflared / ngrok) to the api, e.g. https://xxxx.ngrok.app
#  - Production: your panel's public HTTPS domain (the frontend nginx proxies /api),
#    e.g. https://hire.yourcompany.com
PUBLIC_BASE_URL=https://your-tunnel-url.example

# ---- Host ports ----
# In PRODUCTION only the admin panel binds a host port (non-standard so it won't clash
# with an existing host Postgres/Redis/nginx). db, redis and api stay on the internal
# docker network. Point your reverse proxy (domain + HTTPS) at FRONTEND_PORT.
FRONTEND_PORT=8090
# For LOCAL dev set FRONTEND_PORT=5173 (the dev override also exposes api:8000, db:5434, redis:6380).

# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_resume
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_resume

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Security (CHANGE THESE FOR PRODUCTION) ----
# Generate JWT secret: openssl rand -hex 32
JWT_SECRET=please-change-me-openssl-rand-hex-32
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable per deployment — it decrypts stored bot tokens & AI keys.
ENCRYPTION_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

# ---- Storage ----
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=15

# ---- CORS (admin panel origins; not needed when served behind the frontend nginx) ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Seed super-admin (created on first boot) ----
SUPERADMIN_EMAIL=admin@airesume.io
SUPERADMIN_PASSWORD=admin12345
SUPERADMIN_NAME=Super Admin

# ---- Frontend (build-time API base; relative so it works on any domain via nginx) ----
VITE_API_BASE_URL=/api/v1
